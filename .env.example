# --- Required ---
# PostgreSQL connection string (any Postgres 14+). Leave EMPTY on Netlify to use the
# Netlify Database provisioned for the site automatically.
DATABASE_URL=postgres://user:password@host:5432/barbershop?sslmode=require
# Public URL of the site, used in booking links sent to customers
APP_URL=https://your-shop.netlify.app
# Long random string (32+ chars) used to sign customer access cookies. e.g. `openssl rand -base64 32`
APP_SECRET=
# Secret for the scheduled expiry job (/api/cron/expire). e.g. `openssl rand -hex 24`
CRON_SECRET=

# One-time key for the /setup page that creates the first admin account (only works while no admin exists).
SETUP_TOKEN=

# --- Optional ---
# Country code added to phone numbers entered with a leading 0 (44 = UK)
DEFAULT_COUNTRY_CODE=44
# Max database connections per server instance (keep low on serverless)
DATABASE_POOL_MAX=5

# Email notifications to customers via Resend (https://resend.com). Leave empty to disable.
RESEND_API_KEY=
EMAIL_FROM="Brass & Blade <bookings@your-domain.com>"

# WhatsApp notifications via the official WhatsApp Business Cloud API (Meta). Leave empty to disable.
# Needs an APPROVED message template with two body variables: {{1}} customer name, {{2}} message.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_GB
